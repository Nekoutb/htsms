# HTSMS staging environment template.
#
# Copy to .env.staging on the host and chmod 600. Every secret here MUST be
# generated independently of production: staging shares a host with the live
# service, so a reused credential would let a staging compromise reach
# production data.
#
# Pin HTSMS_IMAGE to an immutable sha- tag so the running commit is
# unambiguous. Every push to main publishes ghcr.io/nekoutb/htsms:sha-<sha>.
HTSMS_IMAGE=ghcr.io/nekoutb/htsms:latest
HTSMS_ENV_FILE=.env.staging

# Loopback port the host reverse proxy forwards to. Must differ from
# production's 8085 so the two stacks do not collide.
HTSMS_HTTP_PORT=8086

APP_NAME="HTSMS Staging"
# Kept as "production" so staging exercises the same framework behaviour as
# the live service: no debug pages, cached config, real error handling.
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://dev.htsms.cm-ea.com
SUPPORT_EMAIL=contact@cm-ea.com
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Service hostnames resolve inside the staging project's own network, so
# these names are correct even though production uses the same values.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=htsms
DB_USERNAME=htsms
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD_NOT_THE_PRODUCTION_ONE
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD_NOT_THE_PRODUCTION_ONE
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true

# Staging must not be able to email real customers. The log transport keeps
# every message in the container log. Only switch this to a real transport
# with a sending domain and recipient allowlist dedicated to staging.
MAIL_MAILER=log
MAILERSEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=smtp.mailersend.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@cm-ea.com
MAIL_FROM_NAME="HTSMS Staging"

# Cloudflare Turnstile (bot protection on signup/login). Leave blank to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
CORS_ALLOWED_ORIGINS=https://dev.htsms.cm-ea.com
HTSMS_LEGAL_UPDATED="August 2026"
