HTSMS_IMAGE=ghcr.io/nekoutb/htsms:latest
HTSMS_ENV_FILE=.env.production.example
APP_NAME=HTSMS
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://htsms.cm-ea.com
SUPPORT_EMAIL=contact@cm-ea.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=htsms
DB_USERNAME=htsms
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
MAIL_MAILER=mailersend
MAILERSEND_API_KEY=REPLACE_WITH_MAILERSEND_EMAIL_API_TOKEN
MAIL_SCHEME=null
MAIL_HOST=smtp.mailersend.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=contact@cm-ea.com
MAIL_FROM_NAME="HTSMS Customer Service"
